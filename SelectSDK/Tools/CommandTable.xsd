<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="CommandTable"
    targetNamespace="http://schemas.softprocorp.com/select/shell/commandtable/2008/02"
    elementFormDefault="qualified"
    attributeFormDefault="unqualified"
    xmlns="http://schemas.softprocorp.com/select/shell/commandtable/2008/02"
    xmlns:mstns="http://schemas.softprocorp.com/select/shell/commandtable/2008/02"
    xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="CommandTable" type="CommandTableType"></xs:element>

  <xs:element name="Symbols" type="SymbolsType"></xs:element>
  
  <xs:complexType name="CommandTableType">
    <xs:sequence>
      <xs:element name="Using" type="UsingType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="Symbols" type="SymbolsType" minOccurs="0" maxOccurs="1" />
      <xs:element name="Commands" type="CommandsType" minOccurs="1" maxOccurs="1" />
      <xs:element name="KeyBindings" type="KeyBindingsType" minOccurs="0" maxOccurs="1" />
      <xs:element name="Contexts" type="ContextsType" minOccurs="0" maxOccurs="1" />
    </xs:sequence>
    <xs:attribute name="package" type="Guid" use="required" />
    <xs:anyAttribute />
  </xs:complexType>

  <xs:complexType name="UsingType">
    <xs:attribute name="alias" type="xs:string" use="required" />
    <xs:attribute name="href" type="xs:anyURI" use="required" />
  </xs:complexType>

  <xs:complexType name="SymbolsType">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:element type="GuidType" name="Guid" minOccurs ="0" maxOccurs ="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="GuidType">
    <xs:sequence>
      <xs:element name="ID" type="IDType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="name" type="Id" use="required"  />
    <xs:attribute name="value" type="Guid" use="required" />
  </xs:complexType>

  <xs:complexType name="IDType">
    <xs:attribute name="name" type="Id" use="required" />
    <xs:attribute name="value" type="HexOrInt" use="required" />
    <xs:attribute name="export" type="xs:boolean" use="optional" default="false" />
  </xs:complexType>

  <xs:complexType name="CommandsType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Menu" type="MenuType" />
      <xs:element name="Button" type="ButtonType" />
      <xs:element name="ButtonRef" type="ButtonRefType" />
      <xs:element name="MenuRef" type="RootMenuRefType" />
      <xs:element name="GroupRef" type="RootGroupRefType" />
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="KeyBindingsType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="KeyBinding" type="KeyBindingType" />
    </xs:choice>
  </xs:complexType>
  
  <xs:complexType name="ContextsType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Context" type="ContextType" />
      <xs:element name="ContextRef" type="ContextRefType" />
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="ContextType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="ContextItem" type="CommandType" />
    </xs:choice>
    <xs:attribute name="guid" type="IdRef" use="required" />
    <xs:attribute name="text" type="xs:string" use="optional" default="" />
  </xs:complexType>

  <xs:complexType name="ContextRefType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="ContextItem" type="CommandType" />
    </xs:choice>
    <xs:attribute name="guid" type="IdRef" use="required" />
  </xs:complexType>

  <xs:complexType name="KeyBindingType">
    <xs:attribute name="editor" type="IdRef" use="required" />
    <xs:attribute name="shortcut" type="Shortcut" use="required" />
    <xs:attribute name="id" type="IdRef" use="required" />
  </xs:complexType>

  <xs:complexType name="CommandType">
    <xs:attribute name="id" type="IdRef" use="required" />
  </xs:complexType>

  <xs:complexType name="PrioritizedCommandType">
    <xs:complexContent>
      <xs:extension base="CommandType">
        <xs:attribute name="priority" type="HexOrInt" use="optional" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="MenuType">
    <xs:complexContent>
      <xs:extension base="PrioritizedCommandType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="Group" type="GroupType" />
          <xs:element name="GroupRef" type="GroupRefType" />
        </xs:choice>
        <xs:attribute name="kind" type="MenuKind" use="optional" default="Menu" />
        <xs:attribute name="canonicalName" type="xs:string" use="optional" />
        <xs:attribute name="text" type="xs:string" use="optional" default="" />
        <xs:attribute name="smallImage" type="xs:string" use="optional" />
        <xs:attribute name="largeImage" type="xs:string" use="optional" />
        <xs:attribute name="importance" type="HexOrInt" use="optional" default="0" />
        <xs:attribute name="toolTip" type="xs:string" use="optional" default="" />
        <xs:attribute name="style" use="optional" default="None">
          <xs:simpleType>
            <xs:list itemType="MenuStyle" />
          </xs:simpleType>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="MenuRefType">
    <xs:complexContent>
      <xs:extension base="PrioritizedCommandType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="Group" type="GroupType" />
          <xs:element name="GroupRef" type="GroupRefType" />
        </xs:choice>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="RootMenuRefType">
    <xs:complexContent>
      <xs:extension base="CommandType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="Group" type="GroupType" />
          <xs:element name="GroupRef" type="GroupRefType" />
        </xs:choice>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="GroupType">
    <xs:complexContent>
      <xs:extension base="PrioritizedCommandType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="Menu" type="MenuType" />
          <xs:element name="MenuRef" type="MenuRefType" />
          <xs:element name="Button" type="ButtonType" />
          <xs:element name="ButtonRef" type="PrioritizedCommandType" />
          <xs:element name="Combo" type="ComboType" />
          <xs:element name="ComboRef" type="ComboRefType" />
        </xs:choice>
        <xs:attribute name="style" use="optional" default="None">
          <xs:simpleType>
            <xs:list itemType="GroupStyle" />
          </xs:simpleType>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="GroupRefType">
    <xs:complexContent>
      <xs:extension base="PrioritizedCommandType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="Menu" type="MenuType" />
          <xs:element name="MenuRef" type="MenuRefType" />
          <xs:element name="Button" type="ButtonType" />
          <xs:element name="ButtonRef" type="ButtonRefType" />
          <xs:element name="Combo" type="ComboType" />
          <xs:element name="ComboRef" type="ComboRefType" />
        </xs:choice>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="RootGroupRefType">
    <xs:complexContent>
      <xs:extension base="CommandType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="Menu" type="MenuType" />
          <xs:element name="MenuRef" type="MenuRefType" />
          <xs:element name="Button" type="ButtonType" />
          <xs:element name="ButtonRef" type="ButtonRefType" />
          <xs:element name="Combo" type="ComboType" />
          <xs:element name="ComboRef" type="ComboRefType" />
        </xs:choice>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ButtonType">
    <xs:complexContent>
      <xs:extension base="PrioritizedCommandType">
        <xs:attribute name="kind" type="ButtonKind" use="optional" default="Button" />
        <xs:attribute name="text" type="xs:string" use="optional" default="" />
        <xs:attribute name="canonicalName" type="xs:string" use="optional" />
        <xs:attribute name="style" use="optional" default="None">
          <xs:simpleType>
            <xs:list itemType="ButtonStyle" />
          </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="smallImage" type="xs:string" use="optional" />
        <xs:attribute name="largeImage" type="xs:string" use="optional" />
        <xs:attribute name="shortcut" type="Shortcut" use="optional" default="None" />
        <xs:attribute name="toolTip" type="xs:string" use="optional" default="" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  
  <xs:complexType name="ButtonRefType">
    <xs:complexContent>
      <xs:extension base="PrioritizedCommandType">
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ComboType">
    <xs:complexContent>
      <xs:extension base="PrioritizedCommandType">
        <xs:attribute name="kind" type="ComboKind" use="optional" default="DropDown" />
        <xs:attribute name="text" type="xs:string" use="optional" default="" />
        <xs:attribute name="name" type="xs:string" use="optional" default="" />
        <xs:attribute name="canonicalName" type="xs:string" use="optional" />
        <xs:attribute name="shortcut" type="Shortcut" use="optional" default="None" />
        <xs:attribute name="toolTip" type="xs:string" use="optional" default="" />
        <xs:attribute name="fillId" type="IdRef" use="required" />
        <xs:attribute name="width" type="xs:int" use="optional" default="150" />
        <xs:attribute name="style" use="optional" default="None">
          <xs:simpleType>
            <xs:list itemType="ComboStyle" />
          </xs:simpleType>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ComboRefType">
    <xs:complexContent>
      <xs:extension base="PrioritizedCommandType">
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  
  <xs:simpleType name="ComboKind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="DropDown" />
      <xs:enumeration value="Dynamic" />
      <xs:enumeration value="Gallery" />
      <xs:enumeration value="ColorPicker" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ComboStyle">
    <xs:restriction base="xs:string">
      <xs:enumeration value="None" />
      <xs:enumeration value="Dynamic" />
      <xs:enumeration value="Stretch" />
      <xs:enumeration value="HighlightSelection" />
      <xs:enumeration value="DefaultDisabled" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MenuKind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Ribbon" />
      <xs:enumeration value="Menu" />
      <xs:enumeration value="Context" />
      <xs:enumeration value="ToolBar" />
      <xs:enumeration value="ApplicationPopup" />
      <xs:enumeration value="QuickAccess" />
      <xs:enumeration value="ButtonBar" />
      <xs:enumeration value="LatchedMenu" />
      <xs:enumeration value="ExtendedStatus" />
      <xs:enumeration value="None" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MenuStyle">
    <xs:restriction base="xs:string">
      <xs:enumeration value="None" />
      <xs:enumeration value="NoText" />
      <xs:enumeration value="TextUnderneath" />
      <xs:enumeration value="Dynamic" />
      <xs:enumeration value="AdvanceSelection" />
      <xs:enumeration value="NoImage" />
    </xs:restriction>
  </xs:simpleType>
  
  <xs:simpleType name="GroupStyle">
    <xs:restriction base="xs:string">
      <xs:enumeration value="None" />
      <xs:enumeration value="Vertical" />
      <xs:enumeration value="Horizontal" />
    </xs:restriction>
  </xs:simpleType>
  
  <xs:simpleType name="ButtonKind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Button" />
      <xs:enumeration value="MenuButton" />
      <xs:enumeration value="HyperLink" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ButtonStyle">
    <xs:restriction base="xs:string">
      <xs:enumeration value="None" />
      <xs:enumeration value="NoText" />
      <xs:enumeration value="TextUnderneath" />
      <xs:enumeration value="Dynamic" />
      <xs:enumeration value="DefaultDisabled" />
      <xs:enumeration value="NoImage" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Id">
    <xs:restriction base="xs:ID">
      <xs:pattern value="^[a-zA-Z_][a-zA-Z_0-9]+$" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IdRef">
    <xs:restriction base="xs:string">
      <xs:pattern value="^([a-zA-Z_][a-zA-Z_0-9]*:)?[a-zA-Z_][a-zA-Z_0-9]+$" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="HexOrInt">
    <xs:restriction base="xs:string">
      <xs:pattern value="^\d+$|^0x[A-F\d]+$" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Guid">
    <xs:restriction base="xs:string">
      <xs:pattern value="^[a-fA-F0-9]{8}-([a-fA-F0-9]{4}-){3}[a-fA-F0-9]{12}$" />
    </xs:restriction>
  </xs:simpleType>

