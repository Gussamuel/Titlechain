<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <UsingTask TaskName="PrepareForBuildPluginPackage" AssemblyFile="SoftPro.Select.Sdk.Tasks.dll"/>

  <!-- ==================================================================== -->
  <!-- BuildDependsOn                                                       -->
  <!-- ==================================================================== -->
  <PropertyGroup>
    <BuildDependsOn>
      $(BuildDependsOn);
      GetSelectPackageOutputs;
      PrepareForBuildPluginPackage;
      BuildPluginPackage;
    </BuildDependsOn>
  </PropertyGroup>

  <!-- ==================================================================== -->
  <!-- CleanDependsOn                                                       -->
  <!-- ==================================================================== -->
  <PropertyGroup>
    <CleanDependsOn>
      $(CleanDependsOn);
      CleanAll;
    </CleanDependsOn>
  </PropertyGroup>

  <!-- ==================================================================== -->
  <!-- CleanAll                                                             -->
  <!-- ==================================================================== -->
  <Target Name="CleanAll">
    <Message Text="Cleaning files in $(OutDir)..." Importance="high" />
    <RemoveDir Directories="$(IntermediateOutputPath)\nuget"/>
    <ItemGroup>
      <FilesToClean Include="$(OutDir)*.nupkg" />
    </ItemGroup>
    <Delete Files="@(FilesToClean)" ContinueOnError="true" />
  </Target>

  <!-- ==================================================================== -->
  <!-- CleanAfterBuild                                                      -->
  <!-- ==================================================================== -->
  <Target Name="CleanAfterBuild" AfterTargets="Build">
    <Message Text="Cleaning files in $(OutDir)..." Importance="high" />
    <Message Text="_CleanAll: $(_CleanAll)" Importance="high" />
    <RemoveDir Directories="$(IntermediateOutputPath)\nuget"/>
    <ItemGroup>
      <FilesToDelete Include="$(OutDir)*.*" Exclude="$(OutDir)*.nupkg" />
    </ItemGroup>
    <Delete Files="@(FilesToDelete)" ContinueOnError="true" />
  </Target>

  <!-- ==================================================================== -->
  <!-- GetSelectPackageOutputs                                              -->
  <!-- ==================================================================== -->
  <Target Name="GetSelectPackageOutputs">

    <MSBuild Projects="@(ProjectReference)" Targets="GetSelectPackageFile">
      <Output TaskParameter="TargetOutputs" PropertyName="SelectPackageOutputs" />
    </MSBuild>

  </Target>

  <!-- ==================================================================== -->
  <!-- PrepareForBuildPluginPackage                                         -->
  <!-- ==================================================================== -->
  <Target Name="PrepareForBuildPluginPackage">

    <Message Text="Preparing to build SoftPro Select Plug-in NuGet package" Importance="high" />
    <PrepareForBuildPluginPackage
      SelectPackageOutputs="$(SelectPackageOutputs)"
      ProjectDir="$(MSBuildProjectDirectory)"
      IntermediateOutputPath="$(IntermediateOutputPath)"
      OutputPath="$(OutputPath)">
      <Output TaskParameter="NuGetBasePath" PropertyName="NuGetBasePath"/>
      <Output TaskParameter="NuGetOutputDir" PropertyName="NuGetOutputDir"/>
    </PrepareForBuildPluginPackage>

  </Target>

  <!-- ==================================================================== -->
  <!-- BuildPluginPackage                                                   -->
  <!-- ==================================================================== -->
  <Target Name="BuildPluginPackage">

    <Message Text="Building SoftPro Select Plug-in NuGet package" Importance="high" />
    <PropertyGroup>
      <NuGetCliTool>$(MSBuildThisFileDirectory)..\tools\nuget.exe</NuGetCliTool>
    </PropertyGroup>
    <Exec Command="$(NuGetCliTool) pack &quot;$(NuGetBasePath)\SelectPlugin.nuspec&quot; -BasePath &quot;$(NuGetBasePath)&quot; -OutputDirectory &quot;$(NuGetOutputDir)&quot; -Verbosity detailed" />

  </Target>

</Project>
